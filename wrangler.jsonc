{
  "name": "portofolio-new",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portofolio-media" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}